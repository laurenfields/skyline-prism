<Project DefaultTargets="Pack">

  <PropertyGroup>
    <AppProject>$(MSBuildThisFileDirectory)..\src\SkylinePrism.App\SkylinePrism.App.csproj</AppProject>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildThisFileDirectory)staging\</PublishDir>
    <ZipDir>$(MSBuildThisFileDirectory)..\publish\</ZipDir>
    <ZipPath>$(ZipDir)SkylinePrism.zip</ZipPath>
  </PropertyGroup>

  <!--
    Publish the WPF App framework-dependent (the user installs the .NET 8 Desktop
    Runtime separately, keeping the zip small) and zip the output plus the tool-inf
    manifest into SkylinePrism.zip - a drop-in Skyline external tool. Mirrors the
    PackageToolZip pattern from pwiz's SkylineAiConnector.csproj / skyline-cadenza.

    Usage:
      dotnet msbuild dotnet/build/package.proj
      dotnet msbuild dotnet/build/package.proj /p:Configuration=Debug
  -->

  <PropertyGroup>
    <!-- Pinned uv launcher for the bundled differential-explorer payload. uv.exe is
         gitignored (large, platform-specific), so fetch it here to make the packaged
         zip reproducible from a clean checkout / CI. -->
    <UvVersion>0.11.28</UvVersion>
    <DiffExplorerDir>$(MSBuildThisFileDirectory)..\src\SkylinePrism.App\diffexplorer\</DiffExplorerDir>
    <UvExe>$(DiffExplorerDir)uv.exe</UvExe>
    <UvZipUrl>https://github.com/astral-sh/uv/releases/download/$(UvVersion)/uv-x86_64-pc-windows-msvc.zip</UvZipUrl>
    <UvTmpDir>$(MSBuildThisFileDirectory)uv-download\</UvTmpDir>
  </PropertyGroup>

  <!-- Ensure the pinned uv.exe is in the payload before publishing. Idempotent: skips
       entirely when a dev copy already exists. TODO: verify a pinned SHA-256 of the
       release asset for supply-chain integrity. -->
  <Target Name="FetchUv" BeforeTargets="Pack" Condition="!Exists('$(UvExe)')">
    <Message Importance="high" Text="uv.exe not found in payload - fetching uv $(UvVersion)..." />
    <MakeDir Directories="$(UvTmpDir)" />
    <DownloadFile SourceUrl="$(UvZipUrl)" DestinationFolder="$(UvTmpDir)">
      <Output TaskParameter="DownloadedFile" PropertyName="UvZipFile" />
    </DownloadFile>
    <Unzip SourceFiles="$(UvZipFile)" DestinationFolder="$(UvTmpDir)" />
    <Copy SourceFiles="$(UvTmpDir)uv.exe" DestinationFiles="$(UvExe)" />
    <RemoveDir Directories="$(UvTmpDir)" />
    <Message Importance="high" Text="Fetched uv $(UvVersion) -> $(UvExe)" />
  </Target>

  <Target Name="Pack">
    <RemoveDir Directories="$(PublishDir)" />
    <MakeDir Directories="$(PublishDir);$(ZipDir)" />
    <Exec Command="dotnet publish &quot;$(AppProject)&quot; -c $(Configuration) -r $(RuntimeIdentifier) --self-contained false /p:UseAppHost=true /p:PublishDir=&quot;$(PublishDir)&quot;" />
    <Delete Files="$(ZipPath)" Condition="Exists('$(ZipPath)')" />
    <ZipDirectory SourceDirectory="$(PublishDir)" DestinationFile="$(ZipPath)" />
    <Message Importance="high" Text="Packaged $(ZipPath)" />
  </Target>

</Project>
