<Window x:Class="SkylinePrism.App.TermProteinsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Term proteins" Height="460" Width="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontSize="14" FontWeight="Bold"
                   Foreground="#1a3c6e" Margin="0,0,0,4" TextWrapping="Wrap" />
        <TextBlock x:Name="SubText" DockPanel.Dock="Top" Foreground="#888" FontSize="11"
                   Margin="0,0,0,8" TextWrapping="Wrap" />
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="protein" Binding="{Binding Protein}" Width="*" />
                <DataGridTextColumn Header="gene" Binding="{Binding Gene}" Width="Auto" />
                <DataGridTextColumn Header="log2FC" Binding="{Binding Log2FC, StringFormat=0.###}" Width="Auto" />
                <DataGridTextColumn Header="adj.P" Binding="{Binding AdjP, StringFormat=0.##e0}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
